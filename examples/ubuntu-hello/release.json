{
  "schema": 2,
  "gitea": "https://git.lan",
  "registry": "git.lan",
  "repository": "dev/container-release-template",
  "source_push": false,
  "release_notes": "docs/releases/0.2.4.md",
  "link_packages": true,
  "remove_local_images": true,
  "version": {"kind": "file", "path": "VERSION"},
  "checks": [["python3", "-B", "-m", "unittest", "discover", "-s", "tests", "-q"]],
  "images": [{
    "name": "container-release-template-hello",
    "platforms": ["linux/amd64", "linux/arm64"],
    "context": "examples/ubuntu-hello",
    "dockerfile": "examples/ubuntu-hello/Dockerfile",
    "verify": ["python3", "-B", "examples/ubuntu-hello/verify.py"]
  }]
}
